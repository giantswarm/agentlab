# A workflow exists purely so the Giant Swarm Backstage muster plugin has
# something to show: its main surface is the workflow list, and a freshly
# installed muster ships none, leaving the "Workflows" tab empty.
#
# Tool names are the kubernetes family's (the lab's MCPServer
# {{ .MCPServerName }} is its member): x_kubernetes_<tool>, the argument
# management_cluster selecting the lab's cluster.
apiVersion: muster.giantswarm.io/v1alpha1
kind: Workflow
metadata:
  name: lab-cluster-overview
  namespace: agent-platform
spec:
  description: >-
    Lab demo: list the namespaces in the kind cluster, then the pods in one of
    them. Exercises the whole Dex -> Backstage -> muster -> mcp-kubernetes ->
    apiserver chain from a single click in the developer portal.
  args:
    namespace:
      type: string
      required: false
      default: agent-platform
      description: Namespace to list pods from.
  steps:
    - id: namespaces
      description: Every namespace in the cluster.
      tool: x_kubernetes_list
      output: true
      args:
        management_cluster: {{ .ClusterName }}
        resourceType: namespaces
    - id: pods
      description: Pods in the requested namespace.
      tool: x_kubernetes_list
      output: true
      args:
        management_cluster: {{ .ClusterName }}
        resourceType: pods
        namespace: "{{ "{{ .input.namespace }}" }}"
