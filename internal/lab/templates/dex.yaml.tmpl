apiVersion: v1
kind: Namespace
metadata:
  name: dex
---
apiVersion: v1
kind: Secret
metadata:
  name: dex-config
  namespace: dex
stringData:
  config.yaml: |
    issuer: {{ .Issuer }}

    # CRD-backed storage, so the SIGNING KEYS survive pod rolls. With
    # `type: memory` every `agentlab reload` (a config edit rolls the pod by
    # design) rotated the keys and the apiserver rejected all tokens with
    # "failed to verify id token signature" until its JWKS cache refreshed —
    # minutes of every login failing right after the edit that prompted the
    # reload. State still dies with the cluster, so the lab stays throwaway.
    storage:
      type: kubernetes
      config:
        inCluster: true

    web:
      https: 0.0.0.0:5556
      tlsCert: /etc/dex/tls/tls.crt
      tlsKey: /etc/dex/tls/tls.key

    telemetry:
      http: 0.0.0.0:5558

    logger:
      level: debug

    oauth2:
      skipApprovalScreen: true
      # Enables the Resource Owner Password grant against the local connector.
      # This is what makes headless/CI testing a single token request. Lab only.
      passwordConnector: local

    frontend:
      issuer: Dex Lab

    # ---------------------------------------------------------------------
    # The whole point: users that exist ONLY here. No GitHub, no GitLab, no
    # Google, no Keycloak. `groups` on static passwords requires Dex >= v2.45.0.
    # Users come from agentlab.yaml (edit with `agentlab configure`, then
    # `agentlab reload`).
    # ---------------------------------------------------------------------
    enablePasswordDB: true
    staticPasswords:
{{- range .Users }}
      - email: "{{ .Email }}"
        # bcrypt(cost 10) of the password in agentlab.yaml
        hash: "{{ .PasswordHash }}"
        username: "{{ .Username }}"
        name: "{{ .Name }}"
        preferredUsername: "{{ .Username }}"
        emailVerified: true
        userID: "{{ userID .Email }}"
        groups:
{{- range .Groups }}
          - "{{ . }}"
{{- end }}
{{- end }}

    staticClients:
      # `trustedPeers` on client X lists the clients allowed to request *X's*
      # audience through the cross-client scope `audience:server:client_id:X`.
      # It reads backwards from the intuition: to let Backstage mint a token the
      # apiserver accepts, `backstage` belongs on the *kubernetes* client here,
      # not `kubernetes` on the backstage client.
      - id: kubernetes
        name: Kubernetes
        secret: {{ .KubernetesClientSecret }}
        redirectURIs:
          - http://127.0.0.1:{{ .BrowserCallbackPort }}/callback
          - http://localhost:{{ .BrowserCallbackPort }}/callback
        trustedPeers:
          - backstage
          - muster
      # Giant Swarm Backstage. The provider name in app-config must begin with
      # `oidc-` (auth-backend-module-gs only registers a provider whose name has
      # that prefix), and the callback path carries that same provider name:
      # /api/auth/<provider>/handler/frame.
      - id: backstage
        name: Backstage
        secret: {{ .BackstageClientSecret }}
        redirectURIs:
          - {{ .BackstageBaseURL }}/api/auth/oidc-lab/handler/frame
      # muster (Giant Swarm agent platform) acts as an OAuth *client* of Dex
      # and as an OAuth *server* towards MCP clients like Claude Code.
      # redirectURI must equal <muster.oauth.server.baseUrl>/oauth/callback.
      - id: muster
        name: Muster
        secret: {{ .MusterClientSecret }}
        redirectURIs:
          - {{ .MusterBaseURL }}/oauth/callback
          - http://127.0.0.1:{{ .Platform.MusterPort }}/oauth/callback
        # Lets Backstage forward a token muster accepts: muster's
        # trustedAudiences is just ["muster"], so the token has to carry that
        # audience, which needs this cross-client grant.
        trustedPeers:
          - backstage
---
# Kubernetes storage needs its own identity: Dex creates its CRDs on first
# boot and then CRUDs its resources (keys, auth codes, sessions) through the
# apiserver.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: dex
  namespace: dex
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: dex
rules:
  - apiGroups: ["dex.coreos.com"]
    resources: ["*"]
    verbs: ["*"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: dex
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: dex
subjects:
  - kind: ServiceAccount
    name: dex
    namespace: dex
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dex
  namespace: dex
  labels: { app: dex }
spec:
  replicas: 1
  selector:
    matchLabels: { app: dex }
  template:
    metadata:
      labels: { app: dex }
      annotations:
        # Roll the pod whenever the config or served cert changes (stamped by
        # `agentlab reload` / `agentlab up` over this manifest + certs/tls.crt).
        checksum/config: "REPLACED_AT_APPLY"
    spec:
      serviceAccountName: dex
      containers:
        - name: dex
          image: {{ .DexImage }}
          args: ["dex", "serve", "/etc/dex/cfg/config.yaml"]
          ports:
            - { name: https, containerPort: 5556 }
            - { name: telemetry, containerPort: 5558 }
          volumeMounts:
            - { name: config, mountPath: /etc/dex/cfg, readOnly: true }
            - { name: tls, mountPath: /etc/dex/tls, readOnly: true }
            # Dex expands its config through a temp file, so /tmp must be
            # writable even with a read-only root filesystem.
            - { name: tmp, mountPath: /tmp }
          readinessProbe:
            httpGet: { path: /healthz, port: 5558 }
            initialDelaySeconds: 2
            periodSeconds: 3
          resources:
            requests: { cpu: 50m, memory: 64Mi }
            limits: { memory: 128Mi }
          securityContext:
            runAsNonRoot: true
            runAsUser: 1001
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
      volumes:
        - name: config
          secret: { secretName: dex-config }
        - name: tls
          secret: { secretName: dex-tls }
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: dex
spec:
  type: NodePort
  selector: { app: dex }
  ports:
    - name: https
      port: 5556
      targetPort: 5556
      nodePort: {{ .DexPort }}
