# The host vm-manager (platform.vmManager), registered with muster the way the
# platform registers its own management surface (agent-manager, model-manager:
# the agent-platform tool group). vm-manager is the platform's VM provisioner
# and runs on the KVM host itself — a laptop, a bare-metal node — never in a
# pod, so its registration is an MCPServer pointing OUT of the cluster: muster
# dials the host through the kind docker network's gateway. On a management
# cluster the same CR is rendered by the agent-platform chart for the host it
# names; the lab renders it here for the machine that runs the lab.
#
# Identity: the same shape as every downstream the lab aggregates. muster
# forwards the session's Dex id_token byte-identical (auth.forwardToken) and
# vm-manager validates it against the lab Dex's JWKS, trusting the platform
# client's audience — the settings state/vm-manager.env carries for its
# `serve`. A vm-manager running WITHOUT --enable-oauth answers every call
# anonymously; `agentlab vm-manager-test` fails on that (the identity
# boundary is the point of the wiring).
apiVersion: muster.giantswarm.io/v1alpha1
kind: MCPServer
metadata:
  name: {{ .VMManagerServer }}
  namespace: agent-platform
  labels:
    app.kubernetes.io/managed-by: agentlab
    agentlab.giantswarm.io/host-service: {{ .VMManagerServer }}
    muster.giantswarm.io/type: {{ .VMManagerServer }}
    {{ .ToolGroupLabel }}: {{ .ToolGroupAgentPlatform }}
  annotations:
    agentlab.giantswarm.io/purpose: >-
      The vm-manager running on the lab host (platform.vmManager), the
      platform's VM provisioner: KVM VMs with an instance metadata service, a
      vTPM and attestation, reached as x_{{ .VMManagerServer }}_<tool> through
      muster. Proven by `agentlab vm-manager-test`.
spec:
  description: >-
    VM provisioning on the lab host (KVM): images, networks and VMs with
    measured boot and attestation. Call get_host first, then list_images and
    list_networks, then create_vm.
  type: streamable-http
  url: {{ .VMManagerURL }}
  autoStart: true
  auth:
    type: oauth
    forwardToken: true
