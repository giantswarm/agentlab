# ---------------------------------------------------------------------------
# Giant Swarm agent-platform-standalone umbrella chart, tuned for this kind lab.
#
# Component versions are the chart's own tested BOM (Chart.yaml / Chart.lock);
# the lab no longer pins its own. `agentlab platform` pins the chart itself to a
# git SHA instead (platform.apsRef in agentlab.yaml).
#
# The topology mirrors a real installation (and the chart's own kind example,
# examples/kind-lab-dex.yaml): the chart-owned agentgateway Gateway is the
# public edge, terminating TLS for *.{{ .Platform.Domain }} with the lab's
# wildcard cert, and every public route (muster `/`, the agentgateway `/mcp`,
# Backstage) attaches to it. One Dex client (`agent-platform`) serves muster
# and Backstage, per the chart's global.identity convention.
#
# Differences from a real management cluster:
#   * the issuer stays https://localhost:{{ .DexPort }}/dex — the apiserver's
#     OIDC flags need an issuer reachable at boot from the node, which only the
#     Dex NodePort trick provides. muster and Backstage reach it the same way:
#     both run hostNetwork (patched in by `agentlab post-render`; not a chart
#     value), exactly like the kube-apiserver static pod.
#   * no Cilium and no Kyverno -> the umbrella's policy objects are off
#     wholesale, plus each component's own network policy toggles.
#   * the edge is published on a fixed NodePort by a lab-owned Service
#     (the controller-created data-plane Service gets a random one), and
#     inside pods a CoreDNS rewrite points *.{{ .Platform.Domain }} at the
#     edge Gateway Service (outside, nip.io already resolves it to loopback).
# ---------------------------------------------------------------------------

global:
  domain: {{ .Platform.Domain }}
  identity:
    issuerUrl: "{{ .Issuer }}"
    clientId: agent-platform
    existingSecret: agent-platform-secrets
    # The lab CA: OIDC discovery/JWKS against the lab Dex, and the edge's
    # wildcard cert chain (same CA signs both).
    ca:
      secretName: dex-ca
      key: ca.crt
  observability:
    metrics:
      # Gates every monitor object the umbrella itself renders — the kagent
      # controller ServiceMonitor (+ its metrics Service) and the CNPG
      # PodMonitor. Only viable with platform.observability: without it the
      # monitoring.coreos.com CRDs do not exist. The per-component toggle
      # (kagent.kagent.serviceMonitor.enabled below) still applies underneath.
      serviceMonitor:
        enabled: {{ .Platform.Observability }}

# The chart-owned agentgateway Gateway is the public edge: it terminates TLS
# for *.{{ .Platform.Domain }} and every public route attaches to its HTTPS
# listener. NodePort (not the LoadBalancer default) — kind has no LB; the
# lab's pinned NodePort Service does the actual publishing either way.
gatewayApi:
  gateway:
    create: true
    tls:
      secretName: agent-platform-tls
    serviceType: NodePort

# client -> agentgateway /mcp -> muster: agentgateway is the observability
# choke point, muster keeps all per-server connection logic and OAuth.
ingress:
  mode: agentgateway-muster
{{- if .ModelManagerEnabled }}

gateway:
  # The model-manager route's JWT policy makes the data plane fetch Dex's
  # JWKS on 5556; the chart guards that this egress is declared (it only
  # renders a network-policy rule, and the lab runs no policies).
  jwksEgress:
    enabled: true
    namespace: dex
    port: 5556
{{- end }}

components:
  agentgateway:
    enabled: true
  agent-platform-mcps:
    enabled: true
  # mcp-kubernetes ships bundled in the umbrella (enabled by default since
  # APS #44): the subchart at the BOM's version plus an MCPServer CR named
  # mcp-kubernetes, so muster's tools surface as x_mcp-kubernetes_<tool>.
  # The agent runtime: the platform's Agent CRs run here, wired to Anthropic
  # through the default ModelConfig (see the kagent block below). Optional in
  # this lab (platform.agents in agentlab.yaml) — on real clusters agent
  # delivery runs through Flux/GitOps, which the lab only runs as the create
  # flow's delivery engine, so labs not exercising agents skip the runtime.
  kagent:
    enabled: {{ .Platform.Agents }}
{{- if .Platform.Agents }}
    # Expose the kagent controller API through the edge for Backstage's kagent
    # page (the app-config derives its apiBaseUrl from this route). JWT
    # validation stays off like in the chart's kind example; the edge only
    # listens on the host's loopback.
    controllerRoute:
      enabled: true
{{- end }}
{{- if .ModelManagerEnabled }}
  # Managed models (platform.modelManager): the umbrella's model-manager
  # dependency with the Ollama backend (its own values are in the
  # `model-manager:` block below). The route exposes its REST API on the
  # edge at https://agentgateway.{{ .Platform.Domain }}/model-manager — the
  # chart's Backstage app-config points the portal backend there
  # (agentPlatform.modelManager.installations.agent-platform.apiBaseUrl).
  # Unlike the kagent route above, JWT validation is ON: the portal forwards
  # the user's Dex ID token and the gateway is the identity boundary
  # (model-manager checks none itself), so an unauthenticated call answers
  # 401. The lab Dex serves its JWKS over TLS at the issuer path, hence the
  # in-cluster host, the /dex/keys path and the TLS origination against the
  # lab CA (jwks.tls.caSecretName defaults to global.identity.ca.secretName).
  model-manager:
    enabled: true
    route:
      enabled: true
      jwtAuthentication:
        enabled: true
        jwks:
          host: dex.dex.svc.cluster.local
          port: 5556
          path: /dex/keys
          tls:
            enabled: true
{{- end }}
  backstage:
    enabled: {{ .Backstage.Enabled }}
{{- if .Backstage.Enabled }}
    # The chart default requests the dex-k8s-authenticator cross-client
    # audience (Giant Swarm apiservers trust that client id). This lab's
    # apiserver trusts client id `kubernetes`, so that audience is added on
    # top for the Kubernetes plugin's token minting; the kubernetes Dex client
    # lists agent-platform under trustedPeers for it.
    extraScopes:
      - federated:id
      - audience:server:client_id:dex-k8s-authenticator
      - audience:server:client_id:kubernetes
    # The vanilla UI hides the portal's HelmRelease pages, but the create
    # flow's scaffolder result links straight to
    # /deployments/<installation>/helmrelease/<ns>/<name> — without these the
    # link 404s AND a failed agent install is invisible (the agents list only
    # shows Agent CRs that exist). Clusters rides along because the
    # deployments table links cluster details unconditionally and crashes
    # without its routes (giantswarm/backstage#2161).
    enabledExtensions:
      - page:gs/deployments
      - nav-item:gs/deployments
      - page:gs/clusters
      - nav-item:gs/clusters
{{- end }}

muster:
  networkPolicy:
    enabled: false
  # Who may write MCPServer / Workflow CRs *through muster*. These are session
  # writes made with the caller's own identity, so plain k8s RBAC authorizes
  # them — muster only renders the namespaced Role + RoleBinding.
  #
  # The umbrella binds them to Giant Swarm's admin groups, which do not exist
  # in this lab. Rebind to the lab's own admin group: the apiserver runs with
  # --oidc-groups-prefix=oidc:, so Dex's `platform-admins` arrives as
  # `oidc:platform-admins` — the same spelling the lab's RBAC template uses.
  #
  # Helm replaces lists rather than merging them, so this drops the GS groups.
  # Do not "disable" these by emptying the list: the chart hard-`fail`s on an
  # empty subjects list. Use `create: false` to manage access out of band.
  rbac:
    mcpServerEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: "oidc:platform-admins"
    workflowEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: "oidc:platform-admins"
  muster:
    # The umbrella turns muster's ServiceMonitor and PrometheusRule on for the
    # GS observability stack. Only viable with platform.observability, which
    # brings the Prometheus Operator (CRDs + a Prometheus whose selectors
    # match everything — see kube-prometheus-stack-values.yaml.tmpl); without
    # it neither CRD exists and the release fails to render. Note the toggle
    # also changes muster's metrics-exporter env, so flipping observability
    # rolls the muster pod once.
    observability:
      metrics:
        prometheus:
          serviceMonitor:
            enabled: {{ .Platform.Observability }}
          prometheusRule:
            enabled: {{ .Platform.Observability }}
    # Dex serves a self-signed cert; append the lab CA to muster's trust pool.
    extraCaFile:
      path: /etc/muster/ca/extra-ca.pem
      secret:
        name: dex-ca
        key: ca.crt
    oauth:
      # muster's OAuth *client* role: the proxy that signs a user in to a
      # downstream MCP server declaring `auth.type: oauth` — behind
      # core_auth_login and the portal's per-server "Sign in" button. The
      # umbrella leaves it off (real installations turn it on); without it
      # core_auth_login refuses with "OAuth proxy is not enabled" and no
      # per-server sign-in can be exercised. publicUrl is where the
      # downstream's authorization server sends the browser back — the chart
      # defaults callbackPath to /oauth/proxy/callback (distinct from the
      # server role's /oauth/callback) and serves the client ID metadata
      # document at /.well-known/oauth-client.json. The one downstream that
      # needs it is the lab's sign-in fixture, MCPServer
      # {{ .OAuthFixtureServer }} (oauth-fixture.yaml.tmpl).
      mcpClient:
        enabled: true
        publicUrl: "{{ .MusterBaseURL }}"
      server:
        enabled: true
        # The public URL through the edge: what Claude Code dials, and what
        # the OAuth callback and the Dex redirectURI must agree on.
        baseUrl: "{{ .MusterBaseURL }}"
        provider: dex
        dex:
          issuerUrl: "{{ .Issuer }}"
          # Must match global.identity.clientId (the render fails otherwise).
          clientId: agent-platform
          # The issuer is a loopback address; discovery refuses that by default.
          allowPrivateIPOIDC: true
        existingSecret: agent-platform-secrets
        # Lab only: lets Claude Code register itself over DCR without a
        # pre-shared registration token (its loopback port is random, so no
        # other registration gate can be opened for it).
        allowPublicClientRegistration: true
        # Lab only: accept Dex id_tokens as bearer tokens so the stack can be
        # smoke-tested headlessly with the password grant (aud
        # agent-platform), and so Backstage-forwarded tokens (aud
        # dex-k8s-authenticator via the GS auth provider's default
        # cross-client scope) pass.
        trustedAudiences:
          - agent-platform
          - dex-k8s-authenticator
        storage:
          type: valkey
          valkey:
            url: muster-valkey:6379

{{- if .Platform.Agents }}
kagent:
  kagent:
    # The default ModelConfig every agent starts from (the kagent subchart
    # renders it from providers.<default>). The chart would only create the
    # referenced Secret if the raw key were inlined in these values — which
    # would put a real credential into state/ and the Helm release Secret —
    # so the lab pre-creates kagent-anthropic from $ANTHROPIC_API_KEY instead
    # (`agentlab platform`, after the install; agents mount it at run time).
    providers:
      default: anthropic
      anthropic:
        provider: Anthropic
        model: {{ .AIModel }}
        apiKeySecretRef: kagent-anthropic
        apiKeySecretKey: ANTHROPIC_API_KEY
    controller:
      auth:
        # The umbrella default is trusted-proxy, which decodes bearer claims
        # WITHOUT verification and relies on a JWT-validating agentgateway
        # policy in front (controllerRoute.jwtAuthentication, off in this
        # lab). The kagent UI's direct NodePort path sends no bearer at all,
        # so upstream's local-dev mode is the honest setting here.
        mode: unsecure
    # Publish the UI on the host through the kind port mapping. NodePort is a
    # chart value, but the chart's ui-service template renders no `nodePort`
    # field (a random one would be useless to kind's fixed mappings), so
    # `agentlab post-render` pins it to KagentUINodePort (HACKS.md U9).
    ui:
      service:
        type: NodePort
    # The umbrella's per-object toggle for the kagent controller
    # ServiceMonitor it renders (templates/kagent/servicemonitor.yaml —
    # the kagent subchart itself ships none); the umbrella-level gate is
    # global.observability.metrics.serviceMonitor.enabled above, and the
    # controller already serves plain-HTTP /metrics on :8080 via the
    # umbrella's default METRICS_BIND_ADDRESS/METRICS_SECURE env.
    serviceMonitor:
      enabled: {{ .Platform.Observability }}
    # No OTLP gateway in kind; the exporters would only log dial errors.
    otel:
      tracing:
        enabled: false
      logging:
        enabled: false
{{- end }}

{{- if .ModelManagerEnabled }}
# The model-manager chart's own values (the umbrella pins the Service name,
# the kagent namespace and the muster registration in its contract). The
# Ollama backend dials the host through the kind docker network's gateway —
# autodetected by `agentlab platform` (platform.modelManager.endpoint
# overrides). Agent pods dial the same address, so agentHost stays empty.
model-manager:
  backend: ollama
  ollama:
    endpoint: {{ .ModelManagerEndpoint | printf "%q" }}
{{- end }}

{{- if .Backstage.Enabled }}
backstage:
  backstage:
    # Helm replaces lists rather than merging them, so the umbrella's own
    # entries are restated here next to the lab's additions (the catalog
    # entities + the scaffolder Template behind the agent create flow, and an
    # in-memory database — see backstage-catalog.yaml.tmpl).
    extraAppConfig:
      - filename: app-config.agent-platform.yaml
        configMapRef: agent-platform-backstage-app-config
      - filename: app-config.agentlab.yaml
        configMapRef: agentlab-backstage-app-config
    extraVolumes:
      # Restated from the umbrella (global.identity.ca): the lab CA Backstage
      # trusts via NODE_EXTRA_CA_CERTS.
      - name: idp-ca
        secret:
          secretName: dex-ca
          optional: true
      - name: lab-catalog
        configMap:
          name: agentlab-backstage-catalog
    extraVolumeMounts:
      - name: idp-ca
        mountPath: /etc/agent-platform/idp-ca
        readOnly: true
      - name: lab-catalog
        mountPath: /lab-catalog
        readOnly: true
{{- end }}

valkey:
  ciliumNetworkPolicy:
    enabled: false
  valkey:
    # Scraped by the lab Prometheus when platform.observability is on; without
    # it the PodMonitor CR has no CRD to bind to and the whole release fails
    # to render.
    metrics:
      podMonitor:
        enabled: {{ .Platform.Observability }}
    auth:
      usersExistingSecret: agent-platform-secrets
      aclUsers:
        default:
          passwordKey: valkey-password

agent-platform-mcps:
  agentgateway:
    # agentgateway-muster: all MCP traffic routes through muster, which keeps
    # the per-server connection logic, OAuth and token exchange (guard-enforced
    # pairing with ingress.mode).
    viaMuster: true
  # The Kubernetes MCP server is NOT listed here: it is the umbrella's bundled
  # mcp-kubernetes component, which registers its own MCPServer CR. The chart's
  # defaults leave the server unauthenticated in-cluster — muster's own OAuth
  # guards the front door and mcp-kubernetes talks to the apiserver with its
  # ServiceAccount.
{{- if .Platform.Observability }}
  # The Prometheus MCP server, a lab-installed release (observability.go);
  # this entry only registers it with muster. `group` must stay OUTSIDE
  # muster.families (kubernetes, prometheus): a family entry would surface the
  # tools as x_prometheus_<tool> with a required management_cluster argument,
  # while this singleton keeps mcp-kubernetes's UX — x_mcp-prometheus_<tool>,
  # no extra argument. Unauthenticated in-cluster, same stance as
  # mcp-kubernetes.
  mcpServers:
    - name: mcp-prometheus
      cluster: {{ .ClusterName }}
      group: observability
      url: http://mcp-prometheus.monitoring.svc.cluster.local:8080/mcp
      auth:
        mode: none
{{- end }}
