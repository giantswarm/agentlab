# ---------------------------------------------------------------------------
# Giant Swarm agent-platform meta chart — the chart every management cluster
# runs — tuned for this kind lab: the LAB SHAPE.
#
#   * The chart brings its own Flux engine (components.flux.enabled: the
#     flux-engine subchart — Flux Operator + one FluxInstance running source-
#     and helm-controller under the multi-tenancy lockdown, and the tenant
#     identity agent-platform-flux every platform HelmRelease runs as). The
#     lab installs no Flux of its own anymore; the Backstage agent create flow
#     and agent-manager write their agents as HelmReleases into this engine.
#   * The chart does NOT manage itself (gitops.self.enabled: false). With the
#     engine on it would by default render its own OCIRepository + HelmRelease,
#     adopt this release and follow the PUBLISHED chart's version range — the
#     lab installs unreleased charts (platform.chartPath) and dev images
#     (platform.devImages), which that HelmRelease would replace with whatever
#     the registry holds. So the Helm CLI keeps owning the release: `agentlab
#     platform` is one idempotent `helm upgrade --install`, and `helm upgrade`
#     stays the day-2 tool. The chart's two self hooks still render as no-ops.
#   * gitops.namespace stays empty: with the engine on, the platform
#     HelmReleases live in the release namespace next to the identity.
#
# Component versions are the chart's own ranges, resolved by its Flux against
# the registry at reconcile time; `agentlab platform` pins the chart itself
# (platform.chartVersion in agentlab.yaml, an exact release).
#
# The topology mirrors a real installation: the chart-owned agentgateway
# Gateway is the public edge, terminating TLS for *.{{ .Platform.Domain }} with
# the lab's wildcard cert, and every public route (muster `/`, the agentgateway
# `/mcp`, Backstage) attaches to it. One Dex client (`agent-platform`) serves
# muster and Backstage, per the chart's global.identity convention.
#
# Differences from a real management cluster:
#   * the issuer stays https://localhost:{{ .DexPort }}/dex — the apiserver's
#     OIDC flags need an issuer reachable at boot from the node, which only the
#     Dex NodePort trick provides. muster and Backstage reach it the same way:
#     both run hostNetwork, exactly like the kube-apiserver static pod — a
#     per-component `postRenderers` patch below (not a chart value in either
#     chart); the MCP servers get a `dex-localhost` sidecar the same way.
#   * no Cilium, and Kyverno only for the fleet's flux-multi-tenancy policy
#     (admission.go): the chart's own Kyverno objects are pinned off below —
#     the `auto` knob would render them once kyverno.io/v1 is served — and
#     the connectivity network policies are off wholesale.
#   * the edge is published on a fixed NodePort by a lab-owned Service
#     (the controller-created data-plane Service gets a random one), and
#     inside pods a CoreDNS rewrite points *.{{ .Platform.Domain }} at the
#     edge Gateway Service (outside, nip.io already resolves it to loopback).
# ---------------------------------------------------------------------------

global:
  domain: {{ .Platform.Domain }}
  identity:
    issuerUrl: "{{ .Issuer }}"
    clientId: agent-platform
    existingSecret: agent-platform-secrets
    # The lab CA: OIDC discovery/JWKS against the lab Dex, and the edge's
    # wildcard cert chain (same CA signs both).
    ca:
      secretName: dex-ca
      key: ca.crt
  observability:
    metrics:
      # Gates every monitor object the connectivity chart renders — the kagent
      # controller ServiceMonitor (+ its metrics Service) — and the component
      # copies the chart derives from it. The chart would detect the
      # Prometheus Operator (`auto`); explicit here so the render never
      # depends on what happened to be installed first. Only viable with
      # platform.observability: without it the monitoring.coreos.com CRDs do
      # not exist.
      serviceMonitor:
        enabled: {{ .Platform.Observability }}

gitops:
  # Self-management OFF — the lab shape (see the header). Never drop this on
  # a lab: the first upgrade without it renders the chart's own HelmRelease
  # and an admission policy that refuses every later `helm upgrade`.
  self:
    enabled: false

# The chart-owned agentgateway Gateway is the public edge: it terminates TLS
# for *.{{ .Platform.Domain }} and every public route attaches to its HTTPS
# listener. NodePort (not the LoadBalancer default) — kind has no LB; the
# lab's pinned NodePort Service does the actual publishing either way.
gatewayApi:
  gateway:
    create: true
    tls:
      secretName: agent-platform-tls
    serviceType: NodePort

# client -> agentgateway /mcp -> muster: agentgateway is the observability
# choke point, muster keeps all per-server connection logic and OAuth. The
# chart's default is the fleet's muster-direct; this is the standalone
# umbrella's full-platform contract, set explicitly like every other default of
# it (the six components below, viaMuster, the stream timeout).
ingress:
  mode: agentgateway-muster
  httpRoute:
    # No stream timeout on the chart-owned routes: MCP sessions are long-lived
    # SSE streams.
    timeouts:
      request: "0s"

# The connectivity chart's network policies. No Cilium in kind, and kind's
# kindnetd DOES enforce plain NetworkPolicy — the lab keeps every component's
# traffic open instead of describing it (the host model servers, the lab Dex,
# the edge).
networkPolicy:
  enabled: false

# The chart's own kyverno.io objects — PolicyExceptions to the fleet's Pod
# Security Standards policies and the mutate policies of agent-sandbox and
# model serving — stay off: the lab's Kyverno (admission.go) enforces the
# fleet's flux-multi-tenancy policy and nothing else, so the exceptions would
# except from policies that are not here and the mutate policies would change
# pods no lab proof ever ran with. `auto` would turn them on with the API
# served; pinned so a lab with and without the fleet's admission renders the
# same platform.
kyvernoPolicies:
  enabled: false

gateway:
  # The JWT policies on the kagent controller route and the model-manager
  # route make the data plane fetch Dex's JWKS on 5556; the chart guards that
  # this egress is declared (it only renders a network-policy rule, and the
  # lab runs no policies).
  jwksEgress:
    enabled: true
    namespace: dex
    port: 5556

# The component roster. `postRenderers` are Flux kustomize post-renderers the
# chart forwards verbatim to that component's HelmRelease — the lab's patches
# on the component charts' renders (postrenderers.go: hostNetwork on muster
# and Backstage, the dex-localhost sidecar on every Deployment the component
# charts tell the lab Dex's localhost address, the kagent UI NodePort, and the
# dev-image overrides from platform.devImages). The sidecar's targets are
# read off the component renders, so `agentlab platform` renders this file
# twice: without them for the roster render, then with them for the install;
# a plain `agentlab render` shows the first. Components this roster does not
# name — turned on by the chart's defaults or an overlay — take their patches
# from the range at the roster's end.
components:
  # The bundled engine: the lab shape's first half (see the header).
  flux:
    enabled: true
  # Avatars for agents; nothing in the lab renders them, and its route needs
  # an Envoy filter kind has no implementation of.
  dicebear:
    enabled: false
  muster:
{{- with index .PostRenderers "muster" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
  agentgateway:
    enabled: true
  agent-platform-mcps:
    enabled: true
{{- with .ConnectivityChart }}
  # The wiring chart of the checkout (platform.chartPath; connectivity.go).
  # The meta chart installs agent-platform-connectivity at its own version —
  # for a checkout the placeholder of its Chart.yaml, which no registry
  # publishes — so the lab pushes the checkout's copy into the lab registry
  # at that version and points the release there: the two charts of one
  # working tree, as CI publishes them for a commit.
  agent-platform-connectivity:
    repository: {{ .Repository }}
    insecure: true
    versionRange: "{{ .Version }}"
{{- end }}
  # The Kubernetes MCP server (registered with muster by the connectivity
  # chart's MCPServer CR): an OAuth resource server against global.identity;
  # muster forwards the user's Dex id_token, and enableDownstreamOAuth then
  # presents that token to the kind apiserver, which trusts the lab Dex with
  # client id `kubernetes` (kind-config.yaml.tmpl) — so the token must carry
  # that audience (mcp-kubernetes.kubernetesAudience below).
  mcp-kubernetes:
    enabled: true
{{- with index .PostRenderers "mcp-kubernetes" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
  # The agent runtime — kagent API v2: AgentTemplates admitted by the platform
  # Harness run as Agent Substrate actors in gVisor worker pods, wired to
  # Anthropic through the default ModelConfig (see the kagent block below).
  # Substrate itself (substrate-crds, substrate — the control plane in
  # ate-system and the per-node atelet) follows this switch inside the chart:
  # the lab installs nothing of it. Optional in this lab (platform.agents in
  # agentlab.yaml).
  kagent:
    enabled: {{ .Platform.Agents }}
{{- if .Platform.Agents }}
    postRenderers:
{{ index .PostRenderers "kagent" | indent 6 }}
{{- if not .LegacyChart }}
  # The platform Postgres: the CloudNativePG operator (the chart's optional
  # component; a management cluster runs it as its own app) and, under
  # postgres.enabled below, the CNPG Cluster the connectivity chart renders
  # with kagent's and Substrate's databases on it — the fleet's shape, so the
  # connectivity chart's Database CRs and derived connection Secrets run
  # here for real. Rides with the agents: nothing else in the lab needs it.
  cloudnative-pg:
    enabled: true
{{- end }}
  # The agent write surface (agents as HelmReleases of the agent chart, as
  # the caller), on whenever kagent is — the standalone umbrella's contract.
  agent-manager:
    enabled: true
{{- with index .PostRenderers "agent-manager" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
{{- end }}
  # Managed models (platform.modelManager): model-manager in front of every
  # host model server of the list (its own values are in the `model-manager:`
  # block below, its edge route in `modelManager:`). The flag is always
  # stated: the chart runs the component by default since agent-platform
  # 4.24.0 (with no backend), and in the lab that pod would only do OIDC
  # discovery against the lab Dex's localhost address without a backend to
  # front — so the lab's toggle off is the component off, not left to the
  # chart's default.
  model-manager:
    enabled: {{ .ModelManagerEnabled }}
{{- if .ModelManagerEnabled }}
{{- with index .PostRenderers "model-manager" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
{{- end }}
{{- if .ServingEnabled }}
  # Model serving on llm-d (platform.serving; serving.go): the
  # LLMInferenceService CRDs and their controller, the well-known
  # LLMInferenceServiceConfigs it composes from, and the modelServing switch
  # — the connectivity chart's serving namespace, the published presets (the
  # shipped GPU ones and the lab's CPU preset, `modelServing:` below), their
  # discovery ConfigMap and the models Gateway. The llm-d controller's
  # release renders the control plane's shared objects itself (the
  # inferenceservice-config, its webhook certificate Issuer, the default
  # ClusterStorageContainer) and the meta chart derives the models Gateway
  # onto it as the Gateway every LLMInferenceService route attaches to; the
  # classic KServe control plane (kserve-crd, kserve-resources) is gone from
  # the chart with the classic InferenceService path
  # (giantswarm/agent-platform#574) — a roster entry for it is refused.
  kserve-llmisvc-crd:
    enabled: true
  kserve-llmisvc-resources:
    enabled: true
{{- with index .PostRenderers "kserve-llmisvc-resources" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
  kserve-runtime-configs:
    enabled: true
  modelServing:
    enabled: true
{{- end }}
{{- if .VMManagerEnabled }}
  # The VM provisioner (platform.vmManager): vm-manager as a pod of the node
  # — privileged, the node's /dev/kvm and /dev/vhost-vsock, the image
  # directory mounted from the node (its own values are in the `vm-manager:`
  # block below).
  vm-manager:
    enabled: true
{{- with index .PostRenderers "vm-manager" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
{{- end }}
{{- if .KlausGatewayEnabled }}
  # Swarmgeist (platform.klausGateway): klaus-gateway as the meta chart's
  # component — A2A to the kagent controller over the in-cluster agentgateway
  # target, Slack on a placeholder Secret, the OBO link store in a Secret
  # (its own values are in the `klausGateway:` block below). The lab's one
  # patch points its Slack Web API at the Service in front of
  # klaus-gateway-test's fake; the dev-image override joins it when
  # platform.devImages names one.
  klaus-gateway:
    enabled: true
{{- with index .PostRenderers "klaus-gateway" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
{{- end }}
  backstage:
    enabled: {{ .Backstage.Enabled }}
{{- if .Backstage.Enabled }}
{{- with index .PostRenderers "backstage" }}
    postRenderers:
{{ . | indent 6 }}
{{- end }}
{{- end }}
{{- range $component, $postRenderers := .ExtraPostRenderers }}
  # A component this roster names no block for under these settings — turned
  # on by the chart's defaults or by a platform.valuesFiles overlay — with the
  # patches the rule found on its render (the dex-localhost sidecar).
  {{ $component }}:
    postRenderers:
{{ $postRenderers | indent 6 }}
{{- end }}

# The connectivity chart's key for the mcp-kubernetes MCPServer CR (dropped
# from the values the mcp-kubernetes chart itself receives): the audience
# muster requests for the forwarded token. The chart default is
# dex-k8s-authenticator (Giant Swarm apiservers); the lab Dex lists
# agent-platform under the kubernetes client's trustedPeers for this.
mcp-kubernetes:
  kubernetesAudience: kubernetes
  # The chart's own Cilium policy defaults on and the meta chart does not
  # derive it from the cluster shape; no Cilium in kind.
  ciliumNetworkPolicy:
    enabled: false

muster:
  networkPolicy:
    enabled: false
  # Who may write MCPServer / Workflow CRs *through muster*. These are session
  # writes made with the caller's own identity, so plain k8s RBAC authorizes
  # them — muster only renders the namespaced Role + RoleBinding.
  #
  # The chart binds them to Giant Swarm's admin groups, which do not exist in
  # this lab. Rebind to the lab's own admin group: the apiserver runs with
  # --oidc-groups-prefix=oidc:, so Dex's `platform-admins` arrives as
  # `oidc:platform-admins` — the same spelling the lab's RBAC template uses.
  #
  # Helm replaces lists rather than merging them, so this drops the GS groups.
  # Do not "disable" these by emptying the list: the chart hard-`fail`s on an
  # empty subjects list. Use `create: false` to manage access out of band.
  rbac:
    mcpServerEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: "oidc:platform-admins"
    workflowEditor:
      subjects:
        - apiGroup: rbac.authorization.k8s.io
          kind: Group
          name: "oidc:platform-admins"
  muster:
    # muster's ServiceMonitor, PrometheusRule and Grafana dashboard: the chart
    # would derive them from global.observability (`auto`); explicit for the
    # same reason as there. Only viable with platform.observability, which
    # brings the Prometheus Operator (CRDs + a Prometheus whose selectors
    # match everything — see kube-prometheus-stack-values.yaml.tmpl); without
    # it neither CRD exists and the release fails to render. Note the toggle
    # also changes muster's metrics-exporter env, so flipping observability
    # rolls the muster pod once.
    observability:
      metrics:
        prometheus:
          serviceMonitor:
            enabled: {{ .Platform.Observability }}
          prometheusRule:
            enabled: {{ .Platform.Observability }}
      grafanaDashboard:
        enabled: false
    # Dex serves a self-signed cert; append the lab CA to muster's trust pool.
    extraCaFile:
      path: /etc/muster/ca/extra-ca.pem
      secret:
        name: dex-ca
        key: ca.crt
    oauth:
      # muster's OAuth *client* role: the proxy that signs a user in to a
      # downstream MCP server declaring `auth.type: oauth` — behind
      # core_auth_login and the portal's per-server "Sign in" button. The
      # chart leaves it off (real installations turn it on); without it
      # core_auth_login refuses with "OAuth proxy is not enabled" and no
      # per-server sign-in can be exercised. publicUrl is where the
      # downstream's authorization server sends the browser back — the chart
      # defaults callbackPath to /oauth/proxy/callback (distinct from the
      # server role's /oauth/callback) and serves the client ID metadata
      # document at /.well-known/oauth-client.json. The one downstream that
      # needs it is the lab's sign-in fixture, MCPServer
      # {{ .OAuthFixtureServer }} (oauth-fixture.yaml.tmpl).
      mcpClient:
        enabled: true
        publicUrl: "{{ .MusterBaseURL }}"
      server:
        enabled: true
        # The public URL through the edge: what Claude Code dials, and what
        # the OAuth callback and the Dex redirectURI must agree on.
        baseUrl: "{{ .MusterBaseURL }}"
        provider: dex
        dex:
          issuerUrl: "{{ .Issuer }}"
          # Must match global.identity.clientId (the render fails otherwise).
          clientId: agent-platform
          # The issuer is a loopback address; discovery refuses that by default.
          allowPrivateIPOIDC: true
        existingSecret: agent-platform-secrets
        # Lab only: lets Claude Code register itself over DCR without a
        # pre-shared registration token (its loopback port is random, so no
        # other registration gate can be opened for it).
        allowPublicClientRegistration: true
        # Lab only: accept Dex id_tokens as bearer tokens so the stack can be
        # smoke-tested headlessly with the password grant (aud
        # agent-platform), and so Backstage-forwarded tokens (aud
        # dex-k8s-authenticator via the GS auth provider's default
        # cross-client scope) pass.
        trustedAudiences:
          - agent-platform
          - dex-k8s-authenticator
        storage:
          type: valkey
          valkey:
            url: muster-valkey:6379

{{- if .Platform.Agents }}
{{- if not .LegacyChart }}
# The platform Postgres — one CNPG Cluster in the kagent namespace holding
# kagent's `kagent_v2` database (postgres.databases.kagent-v2, the vector
# extension for the memory API) and Substrate's control-plane database
# (postgres.databases.substrate, its derived Secret copied into ate-system).
# The chart's shape sized for one kind node: one instance on the local-path
# storage class, a small claim; the fleet runs three on 20Gi. The operand is
# the platform's Postgres image and pgvector rides in as a CNPG ImageVolume
# extension (the fleet's pair; the kind node's kubelet serves image volumes).
postgres:
  enabled: true
  namespace: kagent
  instances: 1
  storage:
    size: 2Gi
  image:
    name: gsoci.azurecr.io/giantswarm/postgresql-cnpg:18.3
  vector:
    enabled: true
    extensionImage:
      reference: gsoci.azurecr.io/giantswarm/pgvector:0.8.2-18-bookworm

# Agent Substrate's stateful parts in the lab shape: the control-plane
# database follows the platform Postgres (postgres.enabled above, the chart's
# `auto`), and the actor snapshot store is the chart's bundled in-cluster
# RustFS — what kagent.harness.snapshotLocation below names. An installation
# brings its own bucket instead.
substrate:
  rustfs:
    enabled: true
  # The lab registry a `harness` dev image is served from
  # (platform.devImages.harness, devimages.go). The Harness's workload image
  # is pulled by Substrate's atelet into its own layer cache, never through
  # the node's containerd, so a side-load cannot reach it; the kind
  # local-registry pattern can: the Harness names the image as
  # localhost:<port>/…@sha256:…, and atelet rewrites that registry to the
  # container's endpoint on the kind docker network (plain HTTP). The chart
  # forwards the flag verbatim to its substrate component. Always on with the
  # agents, not only while a dev image is configured: the flag is inert for
  # every other image ref, and having it in place before a swap means the
  # Harness's new digest can never race ahead of the atelet roll that would
  # carry it — the connectivity release (the Harness) and the substrate
  # release (atelet) reconcile independently. The registry container itself
  # is created on the first swap.
  #
  # The image-cache policy that follows takes the host disk out of atelet's
  # eviction: the cache dir is the kind node's root overlay, i.e. the host's
  # disk, and above the chart's 85 % watermark every GC pass (5 min) would
  # evict the Harness image and the next turn's cold restore overruns the
  # router's budget (ateletImageCacheArgs, substrate.go; docs/platform.md
  # "Platform gotchas"). platform-test asserts the flags on the DaemonSet.
  atelet:
    extraArgs:
      - --localhost-registry-replacement={{ .LocalRegistryEndpoint }}
{{- range .AteletImageCacheArgs }}
      - {{ . }}
{{- end }}
{{- end }}

kagent:
{{- if .LegacyChart }}
  # THE 3.x LINE (a released meta chart below 4.0.0, config.LegacyChart):
  # kagent 0.10 on its bundled Postgres, no platform Harness, no platform
  # Postgres, no Agent Substrate — that chart's root schema is closed and the
  # kagent 0.10 wrapper refuses the keys of the current line, so none of
  # them render here. The controller API through the edge for the Dev
  # Portal's kagent page (the connectivity chart derives the app-config's
  # apiBaseUrl from this route); JWT validation stays off like in that
  # chart's kind example — the edge only listens on the host's loopback.
  controllerRoute:
    enabled: true
{{- else }}
  # The kagent controller's gRPC API through the edge — the Dev Portal, the
  # proofs and klaus-gateway dial it there — with the chart's JWT policy in
  # front (jwtAuthentication.enabled, mode Strict: the fleet shape). The
  # agentgateway data plane verifies the bearer against the lab Dex, refuses
  # a call without one, and sets x-user-id from the verified email claim,
  # replacing whatever the client sent; the controller re-derives the caller
  # from the same bearer (controller.auth.mode trusted-proxy below).
  # platform-test asserts both halves. The chart's default JWKS source is a
  # Giant Swarm Dex; the lab Dex serves its keys over TLS at the issuer path
  # (the model-manager route below uses the same source).
  controllerRoute:
    enabled: true
    jwtAuthentication:
      enabled: true
      mode: Strict
      jwks:
        host: dex.dex.svc.cluster.local
        port: 5556
        path: /dex/keys
        tls:
          enabled: true
  # The platform Harness (the connectivity chart renders it from
  # kagent.harness.image, the line's Go ADK digest the meta chart pins):
  # where Substrate keeps this Harness's actor snapshots — the lab's
  # in-cluster store, the chart's bundled RustFS (substrate.rustfs below).
  # Required by the chart with kagent on; an installation names its bucket.
  harness:
    snapshotLocation: s3://ate-snapshots/kagent
{{- if .HarnessDevImage }}
    # The `harness` dev image (platform.devImages.harness, devimages.go): the
    # build on this host, pushed to the lab registry and pinned by the digest
    # the registry computed for it. The meta chart forwards this to the
    # connectivity chart, which renders it as the platform Harness's workload
    # image — the CRD accepts nothing but a digest — and a changed image
    # recompiles every template the Harness admits (a new golden snapshot per
    # revision). Substrate's atelet pulls it from the registry, rewriting the
    # localhost host to the registry container (substrate.atelet.extraArgs
    # above).
    image: {{ .HarnessDevImage }}
{{- end }}
  # The WorkerPool the chart creates runs its gVisor workers on the one node
  # this lab has, so the chart's CPU feature-set pin must name that node's
  # architecture — the fleet's default is amd64, and on an Apple Silicon host
  # it leaves every worker Pending and every agent turn waiting for one. The
  # arch key alone: Helm merges the map, so the chart keeps the worker
  # resources resources.go budgets for, and workerImage stays the stamp the
  # chart carries from its own Substrate version (the lab never names it).
  # Quoted: a nodeSelector value is a string (the chart's validateWorkerPool
  # fails the render otherwise), and 386 is an architecture YAML reads as an
  # integer.
  substrateWorkerPool:
    template:
      nodeSelector:
        {{ .WorkerPoolArchLabel }}: "{{ .WorkerPoolArch }}"
  # The controller's database is the platform Postgres (postgres.enabled
  # below, the fleet shape): kagent's `kagent_v2` database on the CNPG
  # Cluster, its connection Secret <clusterName>-kagent-v2-app derived by
  # the connectivity release's hook and mounted here as urlFile — the wiring
  # the meta chart documents next to postgres.enabled; the bundled Postgres
  # stays off.
  database:
    postgres:
      urlFile: /etc/cnpg/uri
      vectorEnabled: true
      bundled:
        enabled: false
{{- end }}
  # The default ModelConfig every agent starts from (the kagent chart renders
  # it from providers.<default>). The chart would only create the referenced
  # Secret if the raw key were inlined in these values — which would put a
  # real credential into state/ and the Helm release Secret — so the lab
  # pre-creates kagent-anthropic from $ANTHROPIC_API_KEY instead (`agentlab
  # platform`, after the install; agents mount it at run time).
  providers:
    default: anthropic
    anthropic:
      provider: Anthropic
      model: {{ .AIModel }}
      apiKeySecretRef: kagent-anthropic
      apiKeySecretKey: ANTHROPIC_API_KEY
  controller:
    auth:
{{- if .LegacyChart }}
      # The 3.x line runs no JWT-validating policy in front of the controller
      # (controllerRoute.jwtAuthentication is off above), so trusted-proxy —
      # bearer claims decoded WITHOUT verification — would trust anyone, and
      # the kagent UI's direct NodePort path sends no bearer at all:
      # upstream's local-dev mode is the honest setting here.
      mode: unsecure
{{- else }}
      # The chart's default: the controller decodes the bearer's claims
      # WITHOUT verifying the signature and trusts the JWT-validating
      # agentgateway policy in front of it (controllerRoute.jwtAuthentication
      # above) — the second of the two authentication layers. A caller that
      # bypasses the edge sends no verified bearer and is nobody.
      mode: trusted-proxy
    volumes:
      - name: cnpg-dsn
        secret:
          secretName: kagent-pg-kagent-v2-app
          items:
            - key: uri
              path: uri
    volumeMounts:
      - name: cnpg-dsn
        mountPath: /etc/cnpg
        readOnly: true
{{- end }}
  # Publish the UI on the host through the kind port mapping. NodePort is a
  # chart value, but the chart's ui-service template renders no `nodePort`
  # field (a random one would be useless to kind's fixed mappings), so the
  # kagent postRenderers above pin it to KagentUINodePort (HACKS.md U9).
  ui:
    service:
      type: NodePort
{{- if .LegacyChart }}
  # The connectivity chart's per-object toggle for the kagent controller
  # ServiceMonitor it renders (the kagent chart itself ships none); the
  # chart-level gate is global.observability.metrics.serviceMonitor.enabled
  # above, and the 3.x line's kagent 0.10 controller serves plain-HTTP
  # /metrics on :8080 via the chart's default METRICS_BIND_ADDRESS/
  # METRICS_SECURE env, so the monitor follows observability.
  serviceMonitor:
    enabled: {{ .Platform.Observability }}
{{- else }}
  # The connectivity chart's per-object toggle for the kagent controller
  # ServiceMonitor (the chart-level gate is
  # global.observability.metrics.serviceMonitor.enabled above). Off, the
  # chart's default: the kagent line's controller serves no Prometheus
  # /metrics, and a monitor of a port nobody serves is a target
  # platform-test would wait for. Back on with the chart when upstream
  # serves them.
  serviceMonitor:
    enabled: false
{{- end }}
  # No OTLP gateway in kind; the exporters would only log dial errors.
  otel:
    tracing:
      enabled: false
    logging:
      enabled: false

# The agent-manager chart's own values (the chart pins the Service name, the
# kagent namespace, the muster registration and OAuth against global.identity;
# the tenant identity kagent-flux the agents' HelmReleases execute as is
# derived from kagent.fluxServiceAccountName). Same audience story as
# mcp-kubernetes above: agent-manager writes the HelmRelease and OCIRepository
# of every agent as the caller (downstream OAuth), so the forwarded token must
# carry the `kubernetes` audience to pass the kind apiserver — the lab Dex
# lists agent-platform as a trusted peer of that client.
agent-manager:
{{- if .GitHubToken }}
  # The token agent-manager resolves skills with (list_skills, the
  # create_agent pin, refreshSkills): the Secret the lab creates from
  # $GITHUB_TOKEN (githubtoken.go), lifting the unauthenticated 60-an-hour
  # window this machine's egress address shares. The chart renders it as the
  # Deployment's GITHUB_TOKEN; the repositories list stays the chart's.
  skills:
    github:
      tokenSecret:
        name: agentlab-github-token
        key: GITHUB_TOKEN
{{- end }}
  muster:
    mcpServer:
      auth:
        requiredAudiences:
          - kubernetes
{{- if .GitHubToken }}

# The connectivity chart's wiring for agent-manager: its migrate Job (the
# cut-over the rehearsal drives) resolves skills through GitHub too, from the
# kagent namespace — the same token, the lab's copy of the Secret there
# (githubtoken.go). The Job's env is optional, so a first install, where the
# copy lands after the chart created the namespace, still runs.
agentManager:
  migration:
    githubToken:
      secretName: agentlab-github-token
      key: GITHUB_TOKEN
{{- end }}
{{- end }}

{{- if .ModelManagerEnabled }}
# The model-manager chart's own values (the chart pins the Service name, the
# kagent namespace, the muster registration and OAuth against global.identity).
# ONE model-manager fronts every host model server of
# platform.modelManager.backends (an Ollama, a Lemonade Server, an LM Studio):
# `backends` lists them, the first is the default backend of a request that
# names none, and each dials the host through the kind docker network's
# gateway — autodetected by `agentlab platform`
# (platform.modelManager.endpoints.<backend> overrides). Agent pods dial the
# same addresses, so agentHost stays empty. A single entry renders the chart's
# one-backend form (`backend:`). Same audience story as mcp-kubernetes above:
# the forwarded token must carry the `kubernetes` audience for model-manager's
# downstream OAuth (the ModelConfigs it writes as the caller) to pass the kind
# apiserver.
model-manager:
{{- if eq (len .ModelManagerBackends) 1 }}
  backend: {{ index .ModelManagerBackends 0 }}
{{- else }}
  backends:
{{- range .ModelManagerBackends }}
    - {{ . }}
{{- end }}
{{- end }}
{{- range .ModelManagerBackends }}
{{- /* The kserve backend is the platform's own serving (`modelServing:`
       below), no host server: it has no endpoint and takes the chart's
       kserve defaults — the serving namespace, the discovery ConfigMap. */}}
{{- if ne . "kserve" }}
  {{ . }}:
    endpoint: {{ index $.ModelManagerEndpoints . | printf "%q" }}
{{- end }}
{{- end }}
  muster:
    mcpServer:
      auth:
        requiredAudiences:
          - kubernetes

# The connectivity chart's wiring around model-manager: its REST API on the
# edge at https://agentgateway.{{ .Platform.Domain }}/model-manager, for REST
# clients such as models-test (the portal reaches model-manager through
# muster as the signed-in person, x_model-manager_* tools, and its app-config
# carries no model-manager block). Unlike the kagent route above, JWT
# validation is ON: a caller sends the user's Dex ID token and the gateway is
# the identity boundary (model-manager checks none itself), so an
# unauthenticated call answers 401. The lab Dex serves its JWKS over TLS at the issuer path, hence the
# in-cluster host, the /dex/keys path and the TLS origination against the
# lab CA (jwks.tls.caSecretName defaults to global.identity.ca.secretName).
modelManager:
  route:
    enabled: true
    jwtAuthentication:
      enabled: true
      jwks:
        host: dex.dex.svc.cluster.local
        port: 5556
        path: /dex/keys
        tls:
          enabled: true
{{- end }}

{{- if .ServingEnabled }}
# The KServe control plane's storage-initializer, which downloads a model's
# weights into its pod before the runtime starts: the memory limit the
# inferenceservice-config gives it — rendered by the llm-d controller's own
# release (kserve-llmisvc-resources), the platform's one KServe controller
# since giantswarm/agent-platform#574. The chart's 1Gi is what the Hugging Face
# client's dirty page cache overruns on a download (the initializer was
# OOM-killed mid-download of a 1 GiB model here, and completed on its retry);
# on an installation the connectivity chart's Kyverno policy raises it, and
# the lab runs no Kyverno mutate policies, so the control plane's own value
# carries the platform's. The KServe charts follow this value from 0.4.1
# (giantswarm/kserve#86); the 0.2.x charts the meta chart still pins carry
# the literal, and the initializer retries once until the pin moves
# (giantswarm/agent-platform#582).
kserve-llmisvc-resources:
  kserve:
    storage:
      resources:
        limits:
          memory: 8Gi

# The connectivity chart's serving slice in the lab shape (serving.go). No GPU
# pool, no accelerator RuntimeClass: the kind node is the one node and has no
# GPU. No cache claim: kind's local-path volume
# keeps a root-owned root the KServe storage-initializer cannot write into,
# and a preset's weights download into its pod's own storage at every start
# (a 1 GiB model). No pre-pull DaemonSet: it selects GPU nodes by their
# label. The shipped GPU presets stay published — the portal lists them, and
# a fit check says why none fits here — and the lab adds ONE preset of its
# own, the serving proof's: a small instruct model on the llm-d CPU runtime,
# requesting no GPU, so model-manager places it on the node's CPU capacity.
modelServing:
  serving:
    runtimeClassName: ""
  gpuPool:
    taint:
      key: ""
    nodeSelector: {}
  prepull:
    enabled: false
  cache:
    enabled: false
  presets:
    - apiVersion: agent-platform.giantswarm.io/v1alpha1
      kind: ServingPreset
      metadata:
        name: {{ .Serving.PresetName }}
      spec:
        displayName: Qwen2.5 0.5B Instruct (CPU)
        description: |
          The lab's serving proof: a 0.5B instruct model (~1 GiB of BF16
          weights) on the llm-d CPU runtime, the CPU build of the llm-d release
          the well-known template pins, because the kind node has no GPU. Tool
          calling on (hermes parser), 4k context, eager execution (no compile
          on start). The template's image is the one exception a preset makes:
          the well-known LLMInferenceServiceConfig names the CUDA build.
        model:
          id: {{ .Serving.Model }}
          storageUri: hf://{{ .Serving.Model }}
          format: vLLM
          contextLength: 4096
          capabilities: [chat, tools]
          license: apache-2.0
        args:
          - --max-model-len=4096
          - --enforce-eager
          - --enable-auto-tool-choice
          - --tool-call-parser=hermes
        env:
          # The KV cache the CPU backend reserves, in GiB.
          - name: VLLM_CPU_KVCACHE_SPACE
            value: "2"
          # The CPU image has no passwd entry for the non-root uid the
          # template demands, and torch names its compile cache after the
          # user (getpass.getuser(): $USER first, the passwd database
          # otherwise — a KeyError on this uid); HOME is the template's
          # emptyDir already.
          - name: USER
            value: vllm
        resources:
          gpus: 0
          requests:
            cpu: "4"
            memory: 6Gi
          limits:
            cpu: "8"
            memory: 10Gi
        requirements:
          weightsGiB: 1
          overheadGiB: 5
        template:
          containers:
            - name: main
              image: {{ .Serving.RuntimeImage }}
              # The CPU image runs as root by default and the template
              # demands a non-root user; every path vLLM writes is an
              # emptyDir the template mounts.
              securityContext:
                runAsNonRoot: true
                runAsUser: 1000
                allowPrivilegeEscalation: false
                capabilities:
                  drop: [ALL]
                seccompProfile:
                  type: RuntimeDefault
  # The models Gateway: the agentgateway Gateway every LLMInferenceService
  # route attaches to, TLS on the lab's wildcard certificate (the chart's
  # default, gatewayApi.gateway.tls.secretName), its JWT policy against the
  # lab Dex like the model-manager route above — the JWKS over TLS at the
  # issuer path, the lab's two login clients as the audiences (the platform
  # client the portal, muster and the proofs log in with; the kubernetes
  # client `agentlab login` and kubectl mint their tokens for). No
  # external-dns in kind: the data plane's Service is reached in-cluster
  # through the CoreDNS rewrite of models.<domain> (coredns.yaml.tmpl) and by
  # the proof through a port-forward.
  modelsGateway:
    enabled: true
    name: {{ .Serving.GatewayName }}
    hostPrefix: {{ .Serving.GatewayName }}
    externalDns:
      enabled: false
    jwtAuthentication:
      audiences:
        - {{ .AgentPlatformClientID }}
        - {{ .KubernetesClientID }}
      jwks:
        host: dex.dex.svc.cluster.local
        port: 5556
        path: /dex/keys
        tls:
          enabled: true
{{- end }}

{{- if .VMManagerEnabled }}
# The vm-manager chart's own values, on top of the meta chart's block (the
# pinned Service name, OAuth against global.identity — the lab Dex — and the
# muster registration with the agent-platform tool group): the guest image
# the pod's init container fetches — the lab registry's copy of a local build
# (platform.vmManager.imageDir, pushed at `agentlab platform`, pinned by
# digest so a rebuilt image rolls the pod) or, without one, the artifact the
# chart's release published (the chart default) — and a state claim on the
# node's local-path storage, so the fetched image and the golden PCR values
# recorded into its policy.json survive a pod restart (the lab's VMs and their
# disks with them). The devices come from the node, a privileged container
# with the host's /dev; nothing is mounted from the node.
vm-manager:
{{- with .VMManagerGuestImage }}
  guestImage:
    registry: {{ .Registry }}
    repository: {{ .Repository }}
    tag: {{ .Tag }}
    digest: {{ .Digest }}
    plainHTTP: true
{{- end }}
  persistence:
    create: true
{{- end }}

{{- if .KlausGatewayEnabled }}
# Swarmgeist's own values, on top of the meta chart's klausGateway block (the
# static lifecycle driver, no second agentgateway, the disruption guards;
# klausgateway.go has the reasoning): the in-cluster controller target and
# the proof's fixture as the default agent, the Slack adapter on the lab's
# placeholder Secret, the OBO link store in a Secret
# with the lab's keys Secret mounted, the ServiceMonitor following the
# observability switch. The edge route for the channels stays off.
klausGateway:
  a2a:
    enabled: true
    url: {{ .KlausGateway.A2ATarget }}
    namespace: {{ .KlausGateway.AgentNamespace }}
    defaultAgent: {{ .KlausGateway.DefaultAgent }}
  slack:
    enabled: true
    mode: events
    secretName: {{ .KlausGateway.SlackSecret }}
  obo:
    enabled: true
    store: secret
    musterUrl: {{ .KlausGateway.MusterURL }}
    callbackBaseUrl: {{ .KlausGateway.CallbackBaseURL }}
    existingSecret: {{ .KlausGateway.KeysSecret }}
  serviceMonitor:
    enabled: {{ .Platform.Observability }}
{{- end }}

{{- if .Backstage.Enabled }}
backstage:
  # The connectivity chart's wiring keys (dropped from the values the
  # backstage chart receives). The chart default requests the
  # dex-k8s-authenticator cross-client audience (Giant Swarm apiservers trust
  # that client id). This lab's apiserver trusts client id `kubernetes`, so
  # that audience is added on top for the Kubernetes plugin's token minting;
  # the kubernetes Dex client lists agent-platform under trustedPeers for it.
  extraScopes:
    - federated:id
    - audience:server:client_id:dex-k8s-authenticator
    - audience:server:client_id:kubernetes
  # The vanilla UI hides the portal's HelmRelease pages, but the create
  # flow's scaffolder result links straight to
  # /deployments/<installation>/helmrelease/<ns>/<name> — without these the
  # link 404s AND a failed agent install is invisible (the agents list only
  # shows Agent CRs that exist). Clusters rides along because the
  # deployments table links cluster details unconditionally and crashes
  # without its routes (giantswarm/backstage#2161).
  enabledExtensions:
    - page:gs/deployments
    - nav-item:gs/deployments
    - page:gs/clusters
    - nav-item:gs/clusters
  backstage:
    # Helm replaces lists rather than merging them, so the chart's own
    # entries are restated here next to the lab's additions (the catalog
    # entities + the scaffolder Template behind the agent create flow, an
    # in-memory database, and the gatewayPort-aware baseUrl — see
    # backstage-catalog.yaml.tmpl). The lab file must stay LAST: later files
    # win the deep merge, which is what lets it override the chart's URLs.
    extraAppConfig:
      - filename: app-config.agent-platform.yaml
        configMapRef: agent-platform-backstage-app-config
      - filename: app-config.agentlab.yaml
        configMapRef: agentlab-backstage-app-config
{{- if .GitHubToken }}
    # $GITHUB_TOKEN into the portal's environment from the Secret the lab
    # creates (githubtoken.go); the overlay's integrations.github reads it
    # (backstage-catalog.yaml.tmpl), so the gs backend's skill discovery calls
    # GitHub authenticated — 5000 requests an hour instead of the 60 this
    # machine's egress address shares. A separate list from the umbrella's
    # extraEnvVars, so nothing of the umbrella's is overridden.
    extraEnvVarsSecrets:
      - agentlab-github-token
{{- end }}
    extraVolumes:
      # Restated from the chart (global.identity.ca): the lab CA Backstage
      # trusts via NODE_EXTRA_CA_CERTS.
      - name: idp-ca
        secret:
          secretName: dex-ca
          optional: true
      - name: lab-catalog
        configMap:
          name: agentlab-backstage-catalog
    extraVolumeMounts:
      - name: idp-ca
        mountPath: /etc/agent-platform/idp-ca
        readOnly: true
      - name: lab-catalog
        mountPath: /lab-catalog
        readOnly: true
{{- end }}

valkey:
  ciliumNetworkPolicy:
    enabled: false
  valkey:
    # Scraped by the lab Prometheus when platform.observability is on; without
    # it the PodMonitor CR has no CRD to bind to and the whole release fails
    # to render.
    metrics:
      podMonitor:
        enabled: {{ .Platform.Observability }}
    auth:
      usersExistingSecret: agent-platform-secrets
      aclUsers:
        default:
          passwordKey: valkey-password

agent-platform-mcps:
  agentgateway:
    # agentgateway-muster: all MCP traffic routes through muster, which keeps
    # the per-server connection logic, OAuth and token exchange (guard-enforced
    # pairing with ingress.mode).
    viaMuster: true
  # The Kubernetes MCP server is NOT listed here: the connectivity chart
  # registers the mcp-kubernetes component's MCPServer CR itself (with the
  # forward-token auth block, see mcp-kubernetes.kubernetesAudience above).
{{- if .Platform.Observability }}
  # The Prometheus MCP server, the lab's own release through the platform's
  # engine (mcp-prometheus.yaml.tmpl); this entry only registers it with
  # muster. `group` must stay OUTSIDE muster.families (kubernetes,
  # prometheus): a family entry would surface the tools as
  # x_prometheus_<tool> with a required management_cluster argument, while
  # this singleton keeps mcp-kubernetes's UX — x_mcp-prometheus_<tool>, no
  # extra argument. auth.mode forward: muster forwards the session's Dex
  # id_token byte-identical and mcp-prometheus validates it against Dex's
  # JWKS (mcp-prometheus.yaml.tmpl) — the caller's identity reaches the
  # server. The chart's default audience (dex-k8s-authenticator) rides along;
  # the lab Dex mints it and nothing downstream needs it.
  mcpServers:
    - name: mcp-prometheus
      cluster: {{ .ClusterName }}
      group: observability
      url: http://mcp-prometheus.monitoring.svc.cluster.local:8080/mcp
      auth:
        mode: forward
{{- end }}
