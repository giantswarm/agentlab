kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: {{ .ClusterName }}
nodes:
  - role: control-plane
    # Every mapping binds 127.0.0.1 explicitly. kind defaults listenAddress to
    # 0.0.0.0, which would publish Dex, Backstage and the MCP gateway to the
    # whole local network — pointless here, since every consumer (browser,
    # kubectl, Claude Code) runs on this machine and every redirect URI in the
    # lab is spelled `localhost`.
    #
    # These mappings exist ONLY for the host. Nothing inside the cluster uses
    # them: the apiserver, Backstage and muster all reach Dex through the node's
    # own localhost:{{ .DexPort }}, which hits the NodePort directly.
    #
    # They are fixed when the node container is created, so changing one means
    # `agentlab down && agentlab up` — you cannot map a new port on a running
    # cluster. All four are always mapped, so the platform, agents and
    # Backstage can be enabled later without recreating the cluster.
    extraPortMappings:
      # Dex's NodePort. The lynchpin: the browser on the host and the apiserver
      # inside the node both resolve {{ .Issuer }} to Dex, so the
      # issuer URL is identical on both sides.
      - containerPort: {{ .DexPort }}
        hostPort: {{ .DexPort }}
        listenAddress: "127.0.0.1"
        protocol: TCP
      # Backstage, hostNetwork so it reaches the issuer the same way.
      - containerPort: {{ .Backstage.Port }}
        hostPort: {{ .Backstage.Port }}
        listenAddress: "127.0.0.1"
        protocol: TCP
      # muster (agent platform), hostNetwork for the same reason. The node-side
      # port is the muster chart's default listen port; the host side is what
      # lets Claude Code dial {{ .MusterBaseURL }}/mcp directly, no port-forward.
      - containerPort: {{ .MusterNodePort }}
        hostPort: {{ .Platform.MusterPort }}
        listenAddress: "127.0.0.1"
        protocol: TCP
      # The kagent UI. No issuer trick needed here (the lab UI does no OAuth),
      # so it stays a plain NodePort Service — pinned to this node port by
      # `agentlab post-render`, published as {{ .KagentUIBaseURL }}.
      - containerPort: {{ .KagentUINodePort }}
        hostPort: {{ .Platform.AgentsPort }}
        listenAddress: "127.0.0.1"
        protocol: TCP
    # kubeadm already bind-mounts /etc/kubernetes/pki into the apiserver static
    # pod, so dropping the Dex CA in a subdirectory makes it visible there.
    extraMounts:
      - hostPath: {{ .CertsDir }}
        containerPath: /etc/kubernetes/pki/dex
        readOnly: true
kubeadmConfigPatches:
  # kubelet serializes image pulls by default, so a cold boot queues the
  # platform's images behind each other (the queue wait dwarfs the pulls
  # themselves). The lab pulls from three registries on localhost bandwidth —
  # parallel is strictly better here.
  - |
    apiVersion: kubelet.config.k8s.io/v1beta1
    kind: KubeletConfiguration
    serializeImagePulls: false
  # kind matches a kubeadmConfigPatch by its apiVersion+kind and silently
  # ignores the rest, so BOTH kubeadm generations are patched here: kind v0.31
  # emits kubeadm.k8s.io/v1beta3 (extraArgs is a MAP), kind v0.32+ emits
  # v1beta4 (extraArgs is a LIST of name/value pairs). Whichever matches the
  # generated config applies; the other is a no-op. Dropping either one makes
  # the OIDC flags vanish silently on the other kind version — verify with
  #   docker exec <cluster>-control-plane grep oidc /etc/kubernetes/manifests/kube-apiserver.yaml
  - |
    apiVersion: kubeadm.k8s.io/v1beta3
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        oidc-issuer-url: {{ .Issuer }}
        oidc-client-id: kubernetes
        oidc-ca-file: /etc/kubernetes/pki/dex/ca.crt
        oidc-username-claim: email
        oidc-username-prefix: "oidc:"
        oidc-groups-claim: groups
        oidc-groups-prefix: "oidc:"
  - |
    apiVersion: kubeadm.k8s.io/v1beta4
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        - name: oidc-issuer-url
          value: {{ .Issuer }}
        - name: oidc-client-id
          value: kubernetes
        - name: oidc-ca-file
          value: /etc/kubernetes/pki/dex/ca.crt
        - name: oidc-username-claim
          value: email
        - name: oidc-username-prefix
          value: "oidc:"
        - name: oidc-groups-claim
          value: groups
        - name: oidc-groups-prefix
          value: "oidc:"
