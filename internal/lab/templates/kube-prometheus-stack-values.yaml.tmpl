# ---------------------------------------------------------------------------
# Giant Swarm kube-prometheus-stack, tuned for this kind lab.
#
# This is the observability-bundle's own pinned constituent chart (same
# version, same gsoci images, same curated relabelings), installed directly
# with helm because the bundle itself is MC-shaped: it renders Flux
# HelmReleases with a hardcoded remote kubeconfig secret, dependsOn on
# HelmReleases this lab lacks (cilium, kyverno-crds, VPA CRDs), and Alloy
# configs that only observability-operator + Mimir can provide. The bundle
# also ships NO local PromQL endpoint (prometheus.enabled: false — collection
# goes Alloy -> Mimir on the MC); the lab's whole point here is a queryable
# Prometheus, so it is re-enabled below.
#
# Result (verified against the 22.0.0 chart): prometheus-operator,
# kube-state-metrics, node-exporter, one Prometheus (emptyDir, 10d retention)
# scraping the apiserver, kubelet/cAdvisor (pod CPU/memory), node-exporter
# (node CPU/memory) and kube-state-metrics — everything the
# x_prometheus_* tools need for "how is the control plane / pod X doing".
# ---------------------------------------------------------------------------

# The GS wrapper renders a kyverno.io PolicyException when node-exporter is
# enabled, and its final template fallback carries no Capabilities guard — on
# a Kyverno-less cluster the apply fails on the missing CRD (HACKS.md U12).
kyvernoPolicyExceptions:
  enabled: false

kube-prometheus-stack:
  # Dashboards are out of scope: the platform has no Grafana; the query path
  # is mcp-prometheus via muster. The fleet's alerting rules are too — on a
  # one-node kind cluster they would only page about kind.
  defaultRules:
    create: false
{{- if .AlertmanagerEnabled }}
  # platform.alertmanager: one Alertmanager (the operator's
  # alertmanager-operated Service on 9093, which mcp-prometheus's
  # ALERTMANAGER_URL names) with the chart's own config — every alert routed
  # to the `null` receiver, so nothing is sent anywhere and the API still
  # lists it. The Prometheus sends to it through the alertingEndpoints the
  # chart wires while it is on.
  alertmanager:
    enabled: true
  # The one alert the lab fires: always, like the fleet's Watchdog, so the
  # Alertmanager has an alert for mcp-prometheus's alert tools to read
  # (watchdogAlert in observability.go; platform-test expects it).
  additionalPrometheusRulesMap:
    agentlab-watchdog:
      groups:
        - name: agentlab
          rules:
            - alert: AgentlabWatchdog
              expr: vector(1)
              labels:
                severity: none
              annotations:
                summary: Always firing, so the lab's Alertmanager has an alert to serve.
{{- else }}
  # No Alertmanager unless platform.alertmanager is on.
  alertmanager:
    enabled: false
{{- end }}
  grafana:
    enabled: false
  # GS clusters get node metrics from the separate node-exporter-app, so the
  # GS wrapper disables the bundled one; this lab has no separate app, and
  # node CPU/memory ("how is the control plane?") needs it.
  nodeExporter:
    enabled: true
  # kubeadm binds etcd, scheduler, controller-manager and kube-proxy metrics
  # to 127.0.0.1 on kind, so their targets would only ever show as down.
  kubeEtcd:
    enabled: false
  kubeScheduler:
    enabled: false
  kubeControllerManager:
    enabled: false
  kubeProxy:
    enabled: false
  # The GS wrapper points the CoreDNS metrics Service at k8s-app=coredns;
  # kind labels the pods k8s-app=kube-dns, so the Service would select nothing.
  coreDns:
    enabled: false
  prometheusOperator:
    # Skips the two certgen jobs; fine for a throwaway lab.
    admissionWebhooks:
      enabled: false
    tls:
      enabled: false
  kube-state-metrics:
    # Inert on kindnet anyway (no NetworkPolicy enforcement).
    networkPolicy:
      enabled: false
  prometheus:
    # THE deviation from the bundle's userConfig: a real Prometheus server,
    # the local PromQL endpoint mcp-prometheus queries
    # (http://prometheus-operated.monitoring:9090). Storage is emptyDir —
    # metrics are as throwaway as the cluster.
    enabled: true
    prometheusSpec:
      retention: 10d
      # Served under /prometheus, the path the edge publishes it at
      # (observability-route.yaml.tmpl): the query API Backstage calls and
      # the web UI, whose links and assets then carry the prefix. The
      # operator derives the probes and the self-scrape path from it.
      routePrefix: /prometheus
      externalUrl: {{ .ObservabilityBaseURL }}
      # Upstream's default (…NilUsesHelmValues: true) makes Prometheus select
      # only monitors/rules carrying THIS release's label — but the platform's
      # own monitors (muster, kagent, valkey, mcp-prometheus) come from other
      # releases. Select everything instead; on a one-tenant lab cluster that
      # is exactly what you want.
      serviceMonitorSelectorNilUsesHelmValues: false
      podMonitorSelectorNilUsesHelmValues: false
      ruleSelectorNilUsesHelmValues: false
