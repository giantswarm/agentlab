# agentlab lab configuration. Regenerate with `agentlab configure`.
# Passwords are lab-only throwaway credentials; the hash is cached so
# rendered manifests stay byte-identical across runs (no spurious pod rolls).
clusterName: agentlab
dexPort: 32000
dexImage: ghcr.io/dexidp/dex:v2.45.1
aiModel: claude-sonnet-4-6
users:
    - email: admin@lab.local
      username: admin
      name: Lab Admin
      password: password
      passwordHash: $2a$10$eBu4z0aezFsCgGj9WG2B5eW0q7sOzzeI2768lbOHXQBR7r8Y/eOMK
      groups:
        - platform-admins
        - developers
    - email: dev@lab.local
      username: dev
      name: Lab Developer
      password: password
      passwordHash: $2a$10$kvGoaEzhWS9DkyX4ZQ9BP.l5/v0kEcfKPWwRk8QoxFjpkpP0KEWIW
      groups:
        - developers
    - email: viewer@lab.local
      username: viewer
      name: Lab Viewer
      password: password
      passwordHash: $2a$10$fxVsc/lBqArzi5vTHLGDAOW0.HZWRZeP/MJoL1hoYMw2tQwNk08hi
      groups:
        - viewers
platform:
    enabled: true
    agents: true
    observability: true
    agentsPort: 8081
    musterPort: 8092
    domain: 127.0.0.1.nip.io
    gatewayPort: 443
    tls: {}
    apsRepo: https://github.com/giantswarm/agent-platform-standalone
    apsRef: 24095e95bd7ca458b5f5200f8fb35000930f3284
    modelManager:
        enabled: true
        backend: ollama
    extraModels:
        - name: qwen3-8-27b
          provider: OpenAI
          model: qwen3-8-27b
          baseUrl: https://qwen3-8-27b-kserve.k8s-internal.home.derstappen.com/v1
        - name: qwen35-local
          provider: OpenAI
          model: qwen3.5:9b
