{
  // Repo-specific Renovate rules for agentlab. This file is owned by the repo
  // and never touched by `devctl gen renovate`; it is pulled in as the last
  // `extends` entry of the generated renovate.json5. Class-wide rules belong in
  // giantswarm/renovate-presets instead.
  //
  // config.DefaultChartVersion is the agent-platform release a lab without a
  // chartVersion installs — what `agentlab up` boots in an empty directory. It
  // is an exact pin (the lab never floats) and no built-in manager sees a Go
  // constant, so a stale pin goes unnoticed until a fresh lab cannot boot on
  // it. The manager below proposes every new release as a PR. The lab's CI
  // boots no lab, so the PR is never auto-merged: a fresh default lab on the
  // new version and `agentlab platform-test` come first (the constant's
  // comment says what else a candidate must satisfy).
  customManagers: [
    {
      customType: 'regex',
      description: 'config.DefaultChartVersion follows the agent-platform chart releases',
      managerFilePatterns: ['/^internal/config/config\\.go$/'],
      matchStrings: ['const DefaultChartVersion = "(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?)"'],
      depNameTemplate: 'gsoci.azurecr.io/charts/giantswarm/agent-platform',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    // go-github's major follows the one giantswarm/go-selfupdate imports: the
    // release lookup's *github.RateLimitError comes from go-selfupdate's client,
    // and internal/update matches it with errors.As, which another major's type
    // never matches (a spent rate limit then reads as a network failure). The
    // major moves by hand with the go-selfupdate release that moves its own.
    {
      matchPackageNames: ['github.com/google/go-github{/,}**'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      matchPackageNames: ['gsoci.azurecr.io/charts/giantswarm/agent-platform'],
      automerge: false,
      prBodyNotes: [
        'Before merging: a fresh default lab on this version (`agentlab configure --defaults && agentlab up` in an empty directory) and `agentlab platform-test` pass.',
      ],
    },
    // certificate-transparency-go's next release (HACKS.md U29): v1.4.0 is cut
    // from a branch of v1.3.3 and still pulls etcd/v3 v3.6.8 and prometheus
    // v0.51.0 into the graph, so `.nancy-ignore` carries their findings until a
    // release carries master's Trillian v1.8.0 bump. gomod disables indirect
    // modules; enabled here, every new tag is proposed as a version update.
    // Digest updates stay off: the pin moves to a release, never to a master
    // commit. The go.mod line keeps a bare `// indirect`, since Renovate skips
    // a require line whose comment is more than one word.
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/google/certificate-transparency-go'],
      enabled: true,
      automerge: false,
      prBodyNotes: [
        'With this bump: if `go mod graph` no longer has go.etcd.io/etcd/v3 v3.6.8 or github.com/prometheus/prometheus v0.51.0, drop their `.nancy-ignore` entries and HACKS.md U29; keep `gomod_test.go` green, and after the release `go install github.com/giantswarm/agentlab@<version>` works.',
      ],
    },
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/google/certificate-transparency-go'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
  ],
}
